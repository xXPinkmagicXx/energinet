@page "/flow-2"
@inject FlowService2 FlowService
@rendermode InteractiveServer

<PageTitle>Flow Data</PageTitle>

<h1>Flow Count: @flowCount</h1>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Flow Value <button class="btn btn-secondary" @onclick="SortByValue">Sort</button></th>
            <th>Remove</th>
        </tr>
    </thead>
    <tbody>
        @foreach (FlowData1 flow in flowData)
        {   
            <tr>
                <td>@flow.Name</td>
                <td>@flow.Value</td>
                <td><button class="btn btn-danger" @onclick="() => RemoveFlowData(flow)">Remove</button></td>
            </tr>
        }
        <tr>
            <td>
                <input type="text" @bind="newFlowName" placeholder="Enter flow name" />
            </td>
            <td>
                <input type="number" @bind="newFlowValue" placeholder="Enter flow value" />
            </td>
            <td>
                <button class="btn btn-primary" @onclick="() => AddFlowData(new FlowData1 { Name = newFlowName, Value = newFlowValue })">Add Flow Data</button>
            </td>
        </tr>
    </tbody>
</table>

<CounterTest @bind-currentCount="counter"></CounterTest>
<p>CounterTest currentCount: @counter</p>

@code {

    public int flowCount { get; set; } = 0;
    public string newFlowName { get; set; } = string.Empty;
    public double newFlowValue { get; set; } = 0;

    public int onInitializedAsyncCount { get; set; } = 0;

    public int onAfterRenderAsyncCount { get; set; } = 0;
    public int onParametersSetAsyncCount { get; set; } = 0; 

    public int counter { get; set; } = 0;

    public List<FlowData1> flowData { get; set; } = new List<FlowData1>();

    protected override async Task OnInitializedAsync()
    {
        onInitializedAsyncCount++;
        Console.WriteLine($"Flow2.razor OnInitializedAsync called: {onInitializedAsyncCount} times");
        flowData = await FlowService.GetFlowDataAsync();
        flowCount = flowData.Count;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        onAfterRenderAsyncCount++;
        if (firstRender)
        {
            Console.WriteLine($"Flow2.razor OnAfterRenderAsync called: {onAfterRenderAsyncCount} times");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        onParametersSetAsyncCount++;
        Console.WriteLine($"Flow2.razor OnParametersSetAsync called: {onParametersSetAsyncCount} times");

    }

    public async Task AddFlowData(FlowData1 flowData)
    {
        FlowService.AddFlowData(flowData);
        this.flowData = await FlowService.GetFlowDataAsync();
        flowCount = this.flowData.Count;
        newFlowName = string.Empty;
        newFlowValue = 0;
    }

    public async Task RemoveFlowData(FlowData1 flowData)
    {
        FlowService.RemoveFlowData(flowData);
        this.flowData = await FlowService.GetFlowDataAsync();
        flowCount = this.flowData.Count;
    }

    public void SortByValue()
    {
        this.flowData = FlowService.SortByValue();
    }
    
}
